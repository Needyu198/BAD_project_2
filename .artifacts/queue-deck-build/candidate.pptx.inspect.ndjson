{"kind":"textbox","id":"sh/4f69onal","slide":2,"text":"Refresh the page repeatedly or ask clinic staff for an update.","textPreview":"Refresh the page repeatedly or ask clinic staff for an update.","textChars":62,"textLines":1,"bbox":[70,493,510,88]}
